// 1. HEADER COMMENT
// This is a comment at the very start of the file.

rule "comment-stress-test" on // 2. Between Keywords
    type(Button) || // 3. End of selector line
    type( // 4. Inside selector function
      // Indented comment
      IconButton
    ) 
{
    // 5. Start of body
    meta {
        severity: "warning" // 6. End of property line
        // 7. Full line inside meta
    }

    when: // 8. After keyword, before expression
        // 9. Inside expression logic
        focusable == true 
        && // 10. Between operator and operand
        !hidden

    ensure: 
        // 11. The "Dot Syntax" Check (Crucial)
        // This fails if you use .plus() instead of .star()
        children.length > 0 
        
        // 12. Complex math with comments
        && (children.length + // Adding things
            1) // Closing paren
            >= 
            2 // End of logic

        // 13. Property access with comments (Requires the 'prop' fix)
        && prop
           // deep comment
           ("label") 
           as // casting comment
           string != null

    report: 
        // 14. THE TRAP: Comments inside strings
        // The parser must NOT strip the // inside the quote below
        "Error: Please visit http://example.com/a11y for help."
}

// 15. END OF FILE COMMENT